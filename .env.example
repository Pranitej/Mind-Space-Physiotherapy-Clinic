# ─────────────────────────────────────────────────────────────────────────────
# Environment variables. Copy to `.env.local` for development and add the same
# keys in Vercel → Project → Settings → Environment Variables for production.
# Never commit real values. All keys are validated at runtime (src/lib/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string. Use a dedicated database user with the
# `readWrite` role on this database only (least privilege).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="mindspace"

# Resend (https://resend.com). If RESEND_API_KEY is empty, emails are simulated
# and logged to the server console instead of being sent.
RESEND_API_KEY=""
# Sender. `onboarding@resend.dev` works without a verified domain but can only
# deliver to the email address that owns the Resend account.
EMAIL_FROM="MindSpace Therapy Centre <onboarding@resend.dev>"
# Inbox that receives a notification for every new enquiry.
CLINIC_NOTIFICATION_EMAIL=""

# Admin dashboard password — store the HASH, never the password itself.
# Generate with:  npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=""

# Secret used to sign admin session tokens and hash client IPs (min 32 chars).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Public canonical URL (optional on Vercel, where it is detected automatically).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
